# Kick Developer App (https://kick.com/settings/developer)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Bootstrap / default channel (also seed channels via subscribe script)
KICK_BROADCASTER_USER_ID=538671
KICK_CHANNEL_SLUG=amirphanthom
# Set true only for local dry-run without signature verification
KICK_WEBHOOK_SKIP_VERIFY=false

# Postgres (Railway Postgres plugin injects this when linked)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway

# Streamlit report gate
REPORT_PASSWORD=changeme

HOST=0.0.0.0
PORT=8000

# Re-subscribe if Kick drops chat.message.sent (seconds)
SUBSCRIPTION_WATCHDOG_ENABLED=true
SUBSCRIPTION_WATCHDOG_INTERVAL_SEC=120

# Storage guards (Railway ~5GB Postgres)
# Keep false — raw Kick JSON is the main disk hog
STORE_RAW_PAYLOAD=false
# Delete webhook_events older than N days (0 = never prune)
WEBHOOK_EVENTS_RETENTION_DAYS=7

# --- One-shot Snowflake → Postgres migrate only (not used by the app) ---
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=TBPANDA
# SNOWFLAKE_PRIVATE_KEY=
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=KICK_CHAT
# SNOWFLAKE_SCHEMA=CORE
# SNOWFLAKE_ROLE=SYSADMIN
